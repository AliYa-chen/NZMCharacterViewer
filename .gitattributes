* text=auto
*.sh text eol=lf
*.command text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.ini text eol=lf
*.uasset binary
*.umap binary
*.otf binary
*.png binary
*.psk binary
*.pskx binary
*.hdr binary
# Preserve exported bytes so SHA256 manifests survive cross-platform checkouts.
PCResources/** -text whitespace=cr-at-eol
# Keep upstream notice text intact, including original trailing spaces.
Tools/PCAssetPipeline/**/NOTICE-CUE4Parse.txt -whitespace
